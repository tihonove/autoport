{
  "manifest_version": 3,
  "name": "autoport",
  "description": "Ловит упавшую навигацию на localhost и предлагает пробросить порт",
  "version": "0.1",
  "permissions": ["webRequest", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://local.tsunami.nebius.dev/*",
    "http://local.tsunami.nebius.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
